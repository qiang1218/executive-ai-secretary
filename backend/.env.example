# backend/.env — runtime configuration loaded by Pydantic Settings.
#
# Copy this file to backend/.env, then fill in each value before bringing
# the stack up.  In development you can run the API without any secret
# values (Settings defaults to development-only placeholders), but
# `APP_ENV=production` and `APP_ENV=customer-template` REQUIRE real,
# distinct, high-entropy values for every key marked CHANGE_ME.
#
# Regenerate sessions secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Regenerate the file-encryption key with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Regenerate audit HMAC keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Backup key files are generated with openssl (see deploy/README); they
# live outside this file at runtime/<env>/secrets/backup_*_key.

# ---------------------------------------------------------------------
# App identity / runtime mode
# ---------------------------------------------------------------------
APP_ENV=development
APP_MODE=production
SERVICE_ROLE=api
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://executive_ai:CHANGE_ME@localhost:5432/executive_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=executive_ai
POSTGRES_USER=executive_ai
POSTGRES_MIGRATOR_USER=executive_ai_migrator
POSTGRES_RUNTIME_USER=executive_ai_runtime
POSTGRES_BACKUP_USER=executive_ai_backup

# ---------------------------------------------------------------------
# Session / CSRF
# ---------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_chars
CSRF_SECRET=CHANGE_ME_csrf_secret_at_least_32_chars
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=7200

# ---------------------------------------------------------------------
# Audit HMAC chain
# ---------------------------------------------------------------------
AUDIT_HMAC_KEY=CHANGE_ME_audit_hmac_key_at_least_32_chars
AUDIT_HMAC_KEY_VERSION=v1
AUDIT_HMAC_LEGACY_KEY_VERSION=v1
# Optional: rotate the key by publishing older versions in JSON form, e.g.
#   AUDIT_HMAC_KEY_RING={"v1":"<previous key>","v2":"<current key>"}
AUDIT_HMAC_KEY_RING=

# ---------------------------------------------------------------------
# File encryption (AES-256-GCM, URL-safe base64)
# ---------------------------------------------------------------------
FILE_ENCRYPTION_KEY=CHANGE_ME_file_encryption_key_32_bytes_urlsafe_b64
FILE_ENCRYPTION_KEY_VERSION=v1
FILE_STORAGE_ROOT=./runtime/files
MAX_UPLOAD_BYTES=52428800
FILE_ENCRYPTION_KEY_RING=

# ---------------------------------------------------------------------
# Backup key file paths (openssl-generated, not inline)
# ---------------------------------------------------------------------
# These three files are kept on disk because openssl reads them as files.
# Generate them with the deploy/README instructions.  The values below are
# the defaults; only override them if you store the keys elsewhere.
BACKUP_ENCRYPTION_KEY_FILE=./runtime/local-demo/secrets/backup_encryption_key
BACKUP_SIGNING_KEY_FILE=./runtime/local-demo/secrets/backup_signing_key
BACKUP_SIGNING_PUBLIC_KEY_FILE=./runtime/local-demo/secrets/backup_signing_public_key

# ---------------------------------------------------------------------
# CORS / hosts
# ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------
# Worker tuning (only read when SERVICE_ROLE=worker)
# ---------------------------------------------------------------------
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_JOB_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=60

# ---------------------------------------------------------------------
# Demo / bootstrap (only used in local-demo)
# ---------------------------------------------------------------------
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
