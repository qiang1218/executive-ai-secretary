# Local development environment template — shared by uvicorn and CLI
# Copy to ``backend/.env`` and fill in real values. All values must be
# identical for uvicorn + CLI or audit chain verification will fail.

# ─── Runtime ─────────────────────────────────────────────────────────────────
APP_ENV=development
APP_MODE=demo
# CSV 列表; 测试环境用 testserver,localhost,127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1
# CORS 允许的前端来源 (CSV); 生产环境必须改为真实域名
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=WARNING

# ─── Database ────────────────────────────────────────────────────────────────
# 异步驱动用 postgresql+asyncpg；同步引擎（worker/migration）由 db.session 自动派生
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# 可选: 数仓只读副本 (用于 daily_brief / 数据接入); 不填则用主库
# SOURCE_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

# ─── File Storage ────────────────────────────────────────────────────────────
# 注意: 代码读 FILE_STORAGE_ROOT (或 STORAGE_ROOT); STORAGE_BACKEND/LOCAL_STORAGE_PATH 已废弃
FILE_STORAGE_ROOT=./runtime/files

# ─── Encryption Keys ─────────────────────────────────────────────────────────
# 文件加密 (AES-256-GCM, 32 字节 URL-safe base64)
# 生成: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FILE_ENCRYPTION_KEY=<generate-with-python-urlsafe-b64encode-os.urandom-32>
FILE_ENCRYPTION_KEY_VERSION=v1

# 集成加密 (模型供应商 API key / 高管画像等; 32 字节 URL-safe base64)
# 生成方式同上; 代码内默认值 (aW50ZWdyYXRpb24ta2V5LWJ5dGVzLTMyLXgAAAAAAAA=) 是开发/测试占位, 生产环境必须覆盖!
INTEGRATION_ENCRYPTION_KEY=<generate-with-python-urlsafe-b64encode-os.urandom-32>
INTEGRATION_ENCRYPTION_KEY_VERSION=v1

# ─── Session / CSRF / Audit ──────────────────────────────────────────────────
SESSION_SECRET=<generate-64-char-random-string>
CSRF_SECRET=<generate-64-char-random-string>
AUDIT_HMAC_KEY=<generate-64-char-random-string>
AUDIT_HMAC_KEY_VERSION=v1
AUDIT_HMAC_LEGACY_KEY_VERSION=v1

# ─── Cookie (生产环境必须改) ─────────────────────────────────────────────────
# development 模式默认 false; 生产环境 (APP_ENV=production) 必须设 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Hermes (调用 hermes-agent 网关) ───────────────────────────────────────
# HERMES_TIMEOUT_SECONDS=120

# ─── 可选: Worker / 调度 ─────────────────────────────────────────────────────
# WORKER_POLL_SECONDS=2.0
# WORKER_LEASE_SECONDS=60
# WORKER_HEARTBEAT_SECONDS=15
# WORKER_JOB_MAX_ATTEMPTS=3

# ─── 可选: 数据新鲜度 / Demo 数据 ─────────────────────────────────────────────
# DATA_STALE_AFTER_HOURS=30
# SCHEDULER_POLL_SECONDS=15
# DEMO_REFERENCE_DATE=2026-07-26
# SEED_DEMO_DATA=false
