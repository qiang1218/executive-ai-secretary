# Local development environment template — shared by uvicorn and CLI
# Copy to ``backend/.env`` and fill in real values. All values must be
# identical for uvicorn + CLI or audit chain verification will fail.
APP_ENV=development
APP_MODE=demo
# 同步驱动用 postgresql+psycopg；异步驱动由 configs.settings.database_async_url 自动派生为 postgresql+asyncpg
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./_local_storage
FILE_ENCRYPTION_KEY=7TRkKoYvOgVTqE7gFuKJqaL8ocAMeYS7E3nGIi_FMX8=
FILE_ENCRYPTION_KEY_VERSION=v1
# Integration encryption (model provider API keys / executive personal profile)
# 必须是 32 字节的 URL-safe base64 编码 (解码后 32 字节, AES-256-GCM 密钥).
# 生成方式: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 代码内默认值 (aW50ZWdyYXRpb24ta2V5LWJ5dGVzLTMyLXgAAAAAAAA=) 是开发/测试占位, 生产环境必须覆盖!
INTEGRATION_ENCRYPTION_KEY=aW50ZWdyYXRpb24ta2V5LWJ5dGVzLTMyLXgAAAAAAAA=
INTEGRATION_ENCRYPTION_KEY_VERSION=v1

SESSION_SECRET=0D6//4z7o0hAA5VY+x/gaKzIyV+nVcYsxe5JkAC5Q374zgWY3Vuk28lKiNe4IiUf
CSRF_SECRET=uxYX4FxuVMEI3Kimk3N8ZrKrf+F73bf7Ef0oUZeOgDwint5xVAQOc3AbpSHtdat0
AUDIT_HMAC_KEY=3uAWd5Fp8Bdx6lrC1FDls81WTGXlnmr7kXwkDRX3b+5qhamBOIsC0Lu3gSvFAIKt
AUDIT_HMAC_KEY_VERSION=v1
AUDIT_HMAC_LEGACY_KEY_VERSION=v1

LOG_LEVEL=WARNING
