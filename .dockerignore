# ─── 通用排除 ────────────────────────────────────────────────
**/.git
**/.gitignore
**/.env
**/.env.local
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/.next
**/dist
**/build

# ─── 运行时文件 ──────────────────────────────────────────────
**/runtime/
**/files/
**/*.log
**/*.out
**/*.err

# ─── 部署文件本身 ────────────────────────────────────────────
# 注意：不排除 deploy/init-seed.sh（backend Dockerfile 需要 COPY）
deploy/docker-compose.yml
deploy/.env
deploy/.env.*
deploy/Dockerfile.*
deploy/nginx/
deploy/postgres/
deploy/source-postgres/
docs/

# ─── IDE ─────────────────────────────────────────────────────
**/.vscode
**/.idea
**/*.swp
**/*.swo

# ─── OS ──────────────────────────────────────────────────────
**/.DS_Store
**/Thumbs.db
