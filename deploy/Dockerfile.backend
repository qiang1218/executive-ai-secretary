# ============================================================
# Executive AI Secretary — 后端 + Worker 统一镜像
# ============================================================
# 通过 SERVICE_ROLE 环境变量切换角色：
#   api              后端 API（默认）
#   assistant_worker 后台 Worker（内置 hermes-runtime）
#
# 构建：docker build -t executive-ai-backend -f deploy/Dockerfile.backend .
# ============================================================

# ─── Stage 1: 构建依赖 ─────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

# 换源：apt 使用阿里云镜像
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（Python 包管理器）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 配置 uv 国内镜像源
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV UV_HTTP_TIMEOUT=300

WORKDIR /app

# 先复制依赖清单，利用缓存层
COPY backend/pyproject.toml backend/uv.lock* ./

# 安装全部依赖（含 hermes extra，worker 需要；api 不用但不影响）
# --frozen：使用 uv.lock 中预解算的依赖，不重新解算
# mcp 已纳入 pyproject.toml 的 hermes extra，随 uv sync 一起安装
RUN uv venv /app/.venv \
    && uv sync --extra hermes --no-dev --frozen

# ─── Stage 2: 运行镜像 ─────────────────────────────────────
FROM python:3.12-slim-bookworm AS runner

# 换源：apt 使用阿里云镜像
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update     && apt-get install -y --no-install-recommends \
    libpq5 ca-certificates curl bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从 builder 复制虚拟环境
COPY --from=builder /app/.venv /app/.venv

# 复制后端源码
COPY backend/ ./

# 复制初始化脚本
COPY deploy/init-seed.sh /app/deploy/init-seed.sh
RUN chmod +x /app/deploy/init-seed.sh 2>/dev/null || true

# 创建运行时目录（runtime 卷挂载点）
# - runtime/files：上传文件落盘
# - runtime/skills_active：HERMES_HOME，api 写入 skill、worker 读取
# 挂载 docker named volume 时，目录属主会保持 root；预先创建子目录并放开权限，
# 避免容器内非 root 进程（uvicorn）写入失败。
RUN mkdir -p /app/runtime/files /app/runtime/skills_active \
    && chmod -R 0777 /app/runtime

# 环境变量
ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app/src"
ENV SERVICE_ROLE=api
ENV APP_ENV=production
# HERMES_HOME：与 docker-compose.yml 的 env 保持一致；
# hermes-agent 从 <HERMES_HOME>/skills/<slug>/SKILL.md 加载
ENV HERMES_HOME=/app/runtime/skills_active

EXPOSE 8000

# 默认启动 API；worker 模式通过 compose 的 command 覆盖
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
