# ============================================================
# Executive AI Secretary — Docker 部署环境变量模板
# ============================================================
# 用法：
#   cp .env.docker.example .env
#   按需修改值（尤其是密钥，生产环境必须重新生成）
#
# 生成新密钥（32 字节 URL-safe base64）：
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 生成 64 字符随机字符串（SESSION_SECRET / CSRF_SECRET / AUDIT_HMAC_KEY）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# ─── 运行模式 ─────────────────────────────────────────────────
# APP_ENV: development | local-demo | customer-template | production
# APP_MODE: demo | production（前端通过 NEXT_PUBLIC_APP_MODE 切换）
APP_ENV=production
APP_MODE=production
LOG_LEVEL=INFO

# ─── 对外端口 ─────────────────────────────────────────────────
# 宿主机映射端口（容器内部端口固定：API=8000, 前端=3000, DB=5432）
API_PORT=8000
FRONTEND_PORT=3000
DB_PORT=15432

# ─── 数据库 ───────────────────────────────────────────────────
DB_PASSWORD=executive_ai_dev_2026

# ─── 加密密钥（AES-256-GCM, 32 字节 URL-safe base64）─────────
FILE_ENCRYPTION_KEY=EvTF5Kf2NkyWSZjkjfnIm5Qw18FjU3hzCo9-cMFscss=
FILE_ENCRYPTION_KEY_VERSION=v1
INTEGRATION_ENCRYPTION_KEY=761TnNkQhmxmL4s8ChpzVpJMqT-qSJJZGntQUQ0TngE=
INTEGRATION_ENCRYPTION_KEY_VERSION=v1

# ─── Session / CSRF / 审计链 ──────────────────────────────────
# 生产环境必须重新生成，至少 32 字符
SESSION_SECRET=GCaARx3oS0-AHMD7huYZso3DIVUHiPWfgGA0mbiBkby74wBMAx_dGhiyxRwhJCK5
CSRF_SECRET=7vrlDxKOUBAjxkoiOw-LjtVjQxOPWA13pnZ11HL_8DXsaj3aNNYDr7tzAawodvmJ
AUDIT_HMAC_KEY=IHAoZ6bzAfwAq2WFZtpPpo1vC78VWP8Vy58OFJk-VMW6GSVfaN-jGTCtxgGGK31W
AUDIT_HMAC_KEY_VERSION=v1
AUDIT_HMAC_LEGACY_KEY_VERSION=v1

# ─── Worker 能力令牌 HMAC（worker / assistant_worker 角色必需）──
# worker 与 API 之间校验 capability token 的密钥，至少 32 字符
CAPABILITY_HMAC_KEY=QRyThEtJLt-ywAPjfxZwr4kV5mP2Z6pgVSIJo-iors8=

# ─── Cookie 安全（生产环境必须改）────────────────────────────
# 生产环境（HTTPS）设 true；本地 HTTP 调试保持 false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── 信任主机 / CORS ──────────────────────────────────────────
# CSV 列表；生产环境改为真实域名
TRUSTED_HOSTS=localhost,127.0.0.1,api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── 数据源连接（经营数据同步）─────────────────────────────────
# 脱敏源库连接（DataSource.secret_reference_key=SOURCE_DATABASE_URL 时从这里读取）
# 必须是 PostgreSQL URL，包含主机和数据库名
# 演示环境可指向 docker-compose 里的 source-postgres 服务
SOURCE_DATABASE_URL=postgresql://executive:executive_ai_dev_2026@source-postgres:5432/executive_source_v3
# 数据源连接模式：internal（与主库同实例）/ external（独立实例，默认）
SOURCE_CONNECTION_MODE=external
# 飞书三表写入库（仅 APP_ENV=local-demo + feishu_three_table 模式使用；生产环境留空）
SOURCE_WRITER_DATABASE_URL=

# ─── 前端 ─────────────────────────────────────────────────────
# 浏览器访问 API 的地址（nginx 会代理 /api/ 到后端，因此通常与前端同源）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ─── Worker / Hermes（可选，有默认值）─────────────────────────
WORKER_CONCURRENCY=2
HERMES_MAX_CONCURRENT_RUNS=2
HERMES_MAX_ITERATIONS=10
HERMES_TIMEOUT_SECONDS=120

# ─── 运行时目录（容器内固定，通常无需修改）─────────────────────
# api 与 worker 通过 docker named volume `runtime_data` 共享 /app/runtime：
#   /app/runtime/files         上传文件落盘（FILE_STORAGE_ROOT）
#   /app/runtime/skills_active HERMES_HOME（api 写入 skill、worker 读取）
# 如需覆盖（如宿主机挂载），在 docker-compose.yml 的 volumes 段调整。
